# ── Demo video configuration ─────────────────────────────────────────────
# Copy this file to `.env.local` and fill in values to enable the real
# HTML5 video player on the landing page hero + showcase.
#
# 1. Place your video file in `public/demo/` (e.g. public/demo/vervue-demo.mp4)
#    then set exactly:
NEXT_PUBLIC_DEMO_VIDEO_URL="/demo/vervue-demo.mp4"
#
# 2. Optional: a still poster frame (also lives in public/). The React-built
#    product scene is used as the visual until/unless this is set.
NEXT_PUBLIC_DEMO_VIDEO_POSTER="/demo/vervue-demo-poster.jpg"
