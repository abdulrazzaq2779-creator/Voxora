# Copy to .env.local and fill in. Server-side only: never prefix with NEXT_PUBLIC_.

# Groq (Whisper transcription)
GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo   # or whisper-large-v3 (more accurate, costs more)
# GROQ_WHISPER_LANGUAGE=en                     # ISO-639-1 code; "auto" lets Whisper detect it
# GROQ_WHISPER_PROMPT=                         # short vocabulary hint: program name, technical terms (max ~224 tokens)
# GROQ_MAX_AUDIO_MB=25                         # 25 on the free tier, 100 on the dev tier

# Google AI Studio (scoring LLM)
GOOGLE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Supabase (browser-safe values)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role: SERVER ONLY, never commit, never expose to the browser
# SUPABASE_SERVICE_ROLE_KEY=
